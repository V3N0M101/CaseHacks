{
  "name": "returnproof-demo",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini",
    "TURNSTILE_SITE_KEY": ""
  },
  "ratelimits": [
    {
      "name": "INSPECTION_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
